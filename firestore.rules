rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuPerfil().permissao == "admin" &&
        meuPerfil().bloqueado != true;
    }

    function souTrabalhador() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuPerfil().permissao == "trabalhador" &&
        meuPerfil().bloqueado != true;
    }

    function estouBloqueado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuPerfil().bloqueado == true;
    }

    // Um trabalhador só deveria poder mexer no ciclo que tá rodando AGORA,
    // nunca num ciclo antigo (encerrado) só porque ele sabe o ID -- antes
    // essa checagem não existia, souTrabalhador() sozinho já liberava
    // create/update em QUALQUER cicloId. app.js mantém essa garantia
    // sozinho (só existe um ciclo com status "Ativo" por vez -- todo
    // lugar que cria um ciclo novo primeiro apaga os antigos ou marca o
    // anterior como "Encerrado", ver fecharCicloEIniciarProximo()), então
    // só confere o status do ciclo sendo acessado, sem precisar descobrir
    // "qual é o ativo" (rule não faz esse tipo de busca).
    function cicloEstaAtivo(cicloId) {
      return get(/databases/$(database)/documents/ciclos/$(cicloId)).data.status == "Ativo";
    }

    // [QA-FIX BUG-QA-004] Atalho pra condição de leitura genérica (igual
    // ao que o catch-all antigo usava): autenticado e não bloqueado.
    // Reaproveitado em cada coleção que precisa desse mesmo nível de
    // acesso de leitura, agora de forma explícita em vez de um catch-all
    // único (ver explicação completa no bloco final do arquivo).
    function autenticadoENaoBloqueado() {
      return request.auth != null && !estouBloqueado();
    }

    match /usuarios/{uid} {
      // Sempre pode ler o próprio documento (necessário pra tela de login
      // detectar "conta bloqueada" antes de negar acesso). Ler o cadastro
      // de OUTRO usuário só pra admin -- antes bastava estar logado e não
      // bloqueado, o que deixava qualquer colega ler o perfil completo de
      // qualquer outro, inclusive perguntaSeguranca/respostaSegurancaHash
      // (pergunta de recuperação de senha, de baixa entropia -- nome da
      // mãe, cidade natal etc.). A checagem de "nome de usuário já existe"
      // (usuarioJaExiste em app.js) não precisa mais disso -- usa a lista
      // separada e sem dado sensível em configuracoes/usuariosEmUso logo
      // abaixo.
      allow read: if request.auth != null && (request.auth.uid == uid || souAdmin());

      // Auto-cadastro (tela de login pública): só cria como "padrão" e não
      // bloqueado, não importa o que a pessoa tente mandar no resto do
      // documento. Quando é o ADMIN criando a conta de outra pessoa (tela
      // de Usuários, onde ele escolhe a permissão), não trava nada -- ele
      // já é uma conta de confiança e precisa poder escolher trabalhador/admin.
      allow create: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.permissao == "padrao"
          && request.resource.data.bloqueado == false)
        || souAdmin()
      );

      // Editar o próprio perfil não pode mudar a própria permissão nem se
      // desbloquear sozinho -- só um admin (de verdade, não bloqueado) pode
      // mudar esses dois campos, seja no próprio perfil ou no de outra pessoa.
      allow update: if request.auth != null && (
        souAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.permissao == resource.data.permissao
          && request.resource.data.bloqueado == resource.data.bloqueado)
      );
    }

    // Fechar o ciclo atual e abrir o próximo acontece sozinho (sem
    // precisar de admin) assim que o ÚLTIMO equipamento pendente é
    // concluído -- pode ser um trabalhador comum quem completa esse
    // último item (ver verificarFechamentoCiclo()/
    // fecharCicloEIniciarProximo() em app.js). O documento do ciclo
    // (aqui, não numa subcoleção) não tinha regra própria antes, caía na
    // regra genérica no fim do arquivo (só admin escreve) -- fechar o
    // ciclo falhava com "permissão negada" pra quem não fosse admin (ver
    // auditoria, BUG-004).
    //
    // Em vez de abrir create/update geral em ciclos/{cicloId} pra
    // trabalhador (deixaria criar/editar QUALQUER ciclo com QUALQUER
    // dado), libera só as duas operações exatas que
    // fecharCicloEIniciarProximo() faz. [QA-FIX BUG-QA-004] A leitura
    // (qualquer autenticado não bloqueado) que antes vinha do catch-all
    // genérico agora é explícita aqui.
    match /ciclos/{cicloId} {
      allow read: if autenticadoENaoBloqueado();

      // Fechar o ciclo ATIVO -- nunca reabre um já encerrado, nunca pula
      // pra outro status, e só nos campos que o fechamento de verdade
      // grava (ver updateDoc em fecharCicloEIniciarProximo()).
      allow update: if souTrabalhador()
        && resource.data.status == "Ativo"
        && request.resource.data.status == "Encerrado"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "dataFechamento", "total", "noPrazo", "emAtraso", "porPredio"]);

      // Criar o PRÓXIMO ciclo -- só com os 3 campos que toda criação de
      // ciclo grava (gerarCronograma()/gerarCronogramaSemAgendar()
      // também criam ciclo, mas são telas só de admin na interface; aqui
      // é a regra do banco, mais restrita que "qualquer coisa" de
      // qualquer forma).
      allow create: if souTrabalhador()
        && request.resource.data.keys().hasOnly(["criadoEm", "dataInicio", "status"])
        && request.resource.data.status == "Ativo";
    }

    match /ciclos/{cicloId}/equipamentos/{itemId} {
      allow read: if autenticadoENaoBloqueado(); // [QA-FIX BUG-QA-004]
      allow create, update: if souTrabalhador() && cicloEstaAtivo(cicloId);
    }
    match /ciclos/{cicloId}/backupPlanilha/{docId} {
      // [QA-FIX BUG-QA-004] A leitura era, na prática, igual à de tudo
      // mais (autenticado e não bloqueado) -- a tela de Levantamento é
      // só-admin na interface, e só por isso que ADMIN conseguia ler
      // esse backup antes (via o catch-all genérico, já que essa regra
      // específica nunca incluiu souAdmin()). Sem o catch-all, isso
      // quebrava a tela pra admin -- corrigido tornando a leitura
      // explícita igual à de antes, sem mexer na escrita (continua só
      // trabalhador + ciclo ativo, como sempre foi).
      allow read: if autenticadoENaoBloqueado();
      allow create, update, delete: if souTrabalhador() && cicloEstaAtivo(cicloId);
    }
    match /ciclos/{cicloId}/historico/{id} {
      // Só cria -- editar/apagar um registro já existente fica só com admin
      // (é um log de manutenção, não devia dar pra reescrever depois).
      allow create: if souTrabalhador() && cicloEstaAtivo(cicloId);
    }
    match /ciclos/{cicloId}/ordens/{id} {
      allow create, update, delete: if souTrabalhador() && cicloEstaAtivo(cicloId);
    }

    // [QA-FIX BUG-QA-004] Leitura de "ordens"/"historico" via
    // collectionGroup (ver iniciarSincronizacaoOrdens/
    // iniciarSincronizacaoHistorico e abrirDrawerEquipamento em app.js) --
    // precisa do padrão recursivo "{caminho=**}/colecao/{id}", documentado
    // pelo próprio Firebase como a forma correta de dar suporte a
    // consultas collectionGroup. A condição NÃO pode depender de nenhum
    // valor capturado pelo wildcard (`caminho`), senão a consulta é
    // invalidada pelo mecanismo de validação de regras do Firestore
    // (confirmado por teste direto -- ver BUGQA004_ANALISE.md).
    match /{caminho=**}/ordens/{id} {
      allow read: if autenticadoENaoBloqueado();
    }
    match /{caminho=**}/historico/{id} {
      allow read: if autenticadoENaoBloqueado();
    }

    match /infoCondensadoras/{equipamentoId} {
      allow read: if autenticadoENaoBloqueado(); // [QA-FIX BUG-QA-004]
      allow create, update: if souTrabalhador();
    }

    // Inscrição de notificação push do navegador (ver ativarNotificacoesPush
    // em app.js) -- um documento por pessoa (id = o próprio uid), só ela
    // pode criar/atualizar/apagar a própria. [QA-FIX BUG-QA-004]
    //
    // [AUDIT-FIX] A leitura em massa (list), usada pelo Worker de avisos de
    // atraso pra mandar notificação pra todo mundo, agora exige que a conta
    // que está lendo seja ADMIN -- antes qualquer pessoa logada (trabalhador
    // comum incluído) conseguia listar o endpoint/chave de notificação de
    // todo mundo, que não é senha mas também não precisa ser público pra
    // outro usuário. Pra isso continuar funcionando: a conta "robô" que o
    // Worker usa pra logar (ROBO_EMAIL/ROBO_SENHA, ver
    // cloudflare-worker/worker-aviso-atrasados.js) PRECISA estar cadastrada
    // em usuarios/{uid} com permissao == "admin" -- confira isso no painel
    // de Usuários do sistema antes de publicar esta regra, senão os avisos
    // de atraso param de ser enviados silenciosamente (o Worker não quebra,
    // só manda 0 notificações, ver o .catch() em
    // enviarNotificacoesPush()).
    match /pushSubscriptions/{uid} {
      allow read: if souAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lista de nomes de usuário já em uso (só o nome -- nenhum dado
    // sensível) -- existe pra "Minha conta" avisar "esse usuário já
    // existe" sem precisar ler o perfil completo de ninguém (ver
    // usuarios/{uid} acima, que agora só deixa ler o próprio ou admin).
    // hasOnly(["nomes"]) trava a escrita só nesse campo, pra um usuário
    // mal-intencionado não poder usar esse documento pra gravar outra
    // coisa qualquer.
    //
    // [AUDIT-FIX] app.js só mexe nessa lista via arrayUnion/arrayRemove de
    // UM nome por vez (ver registrarUsuarioEmUso/removerUsuarioEmUso) --
    // nunca manda a lista inteira de uma vez. mudancaDeUmNomeSo() usa isso:
    // só deixa passar um update cuja diferença pro valor antigo seja, no
    // máximo, 1 nome adicionado e 1 nome removido. Isso fecha a brecha de
    // alguém mandar uma lista qualquer (apagando/trocando todo mundo) --
    // antes só o nome do CAMPO era validado, nunca o conteúdo.
    function mudancaDeUmNomeSo() {
      let antigo = resource.data.nomes;
      let novo = request.resource.data.nomes;
      return novo is list && novo.size() <= 1000
        && antigo.toSet().difference(novo.toSet()).size() <= 1
        && novo.toSet().difference(antigo.toSet()).size() <= 1;
    }
    match /configuracoes/usuariosEmUso {
      allow read: if autenticadoENaoBloqueado();
      allow create: if autenticadoENaoBloqueado()
        && request.resource.data.keys().hasOnly(["nomes"])
        && request.resource.data.nomes is list
        && request.resource.data.nomes.size() <= 1;
      allow update: if autenticadoENaoBloqueado()
        && request.resource.data.keys().hasOnly(["nomes"])
        && mudancaDeUmNomeSo();
    }

    // A regra genérica (hoje removida, ver bloco final) só deixava ADMIN
    // escrever -- sem essa regra própria, qualquer pessoa não-admin
    // mudando o próprio nome/usuário/senha em "Minha conta" teria o
    // registro de auditoria negado (a ação em si funciona, só o LOG dela
    // que sumiria, sem erro visível pra ninguém perceber). Só cria (nunca
    // edita/apaga um log já existente); ver quem mudou o quê continua só
    // pra admin -- [QA-FIX BUG-QA-004] essa era a SEGUNDA coleção onde o
    // catch-all genérico anulava a restrição de leitura (só admin lê);
    // sem um catch-all genérico, essa restrição agora vale de verdade.
    //
    // [AUDIT-FIX] A criação continua aberta pra qualquer um (precisa ser
    // assim, ver acima), mas agora valida o conteúdo: só os 4 campos que
    // registrarAuditoria() manda (app.js), com tamanho limitado, e o campo
    // "usuario" tem que bater com o usuário de quem tá autenticado -- antes
    // dava pra criar um registro de auditoria se passando por qualquer
    // outra pessoa. Não dá pra exigir uid junto porque o app nunca manda
    // esse campo (só o nome de usuário) -- ver registrarAuditoria() em
    // app.js.
    match /auditoria/{id} {
      allow read: if souAdmin();
      allow create: if autenticadoENaoBloqueado()
        && request.resource.data.keys().hasOnly(["acao", "detalhes", "usuario", "registradoEm"])
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 200
        && request.resource.data.detalhes is string && request.resource.data.detalhes.size() <= 2000
        && request.resource.data.usuario is string
        && request.resource.data.usuario == meuPerfil().usuario
        && request.resource.data.registradoEm is string;
    }

    match /equipes/{id} {
      allow read: if autenticadoENaoBloqueado(); // [QA-FIX BUG-QA-004]
      allow write: if souAdmin();
    }
    match /feriados/{id} {
      allow read: if autenticadoENaoBloqueado(); // [QA-FIX BUG-QA-004]
      allow write: if souAdmin();
    }
    // Snapshot do painel de análise GLPI/campo (ver "Análise GLPI" em
    // app.js) -- qualquer logado pode VER (é pra mostrar ao supervisor),
    // só admin pode importar/sobrescrever (botões de upload do CSV/xlsx).
    match /analiseGlpi/{id} {
      allow read: if autenticadoENaoBloqueado();
      allow write: if souAdmin();
    }
    match /config/{id} {
      // [QA-FIX BUG-QA-004] Coleção "config" (docs "site" e "cronograma",
      // lidos em toda inicialização do app, por qualquer perfil) --
      // achado por grep sistemático em app.js de TODO collection()/doc()/
      // collectionGroup() de topo, pra não deixar nenhuma coleção sem
      // regra explícita depois de remover o catch-all genérico.
      allow read: if autenticadoENaoBloqueado();
      allow write: if souAdmin();
    }
    match /plantas/{id} {
      allow read: if autenticadoENaoBloqueado(); // [QA-FIX BUG-QA-004]
      allow write: if souAdmin();
    }

    // [QA-FIX BUG-QA-004] A regra genérica original concedia LEITURA
    // (allow read) pra QUALQUER caminho, inclusive usuarios/** e
    // auditoria/**, anulando por completo as restrições específicas
    // dessas duas coleções (causa raiz do BUG-QA-004 -- no Firestore,
    // quando mais de uma regra corresponde ao mesmo caminho, o acesso é
    // concedido se QUALQUER UMA permitir; não existe "a mais específica
    // vence"). Essa leitura genérica foi removida e distribuída,
    // coleção por coleção, nos blocos acima -- sem incluir usuarios/** e
    // auditoria/** na lista, que são as duas que precisavam de restrição
    // de verdade.
    //
    // A parte de ESCRITA do catch-all (sempre documento a documento,
    // nunca "em lote"/list -- por isso não tem o mesmo problema de
    // list/collectionGroup que a leitura tem) continua exatamente igual:
    // cobre a capacidade de admin escrever/apagar em QUALQUER coleção
    // (ex: excluir equipamentos/ordens/histórico, editar cronograma),
    // mesmo onde a regra específica só prevê trabalhador -- como já
    // funcionava antes desta correção.
    //
    // [QA-FIX revisão independente] Exceto auditoria/**: como regras do
    // Firestore são OR (qualquer regra que bata no caminho e permita já
    // libera), esse catch-all também cobria update/delete em auditoria/
    // {id}, mesmo a regra própria dessa coleção (acima) só prevendo
    // "create". Na prática isso deixava admin editar ou apagar um
    // registro de auditoria já existente -- log deixa de ser confiável
    // como histórico imutável. document[0] é o primeiro segmento do
    // caminho capturado por {document=**} (lista de segmentos, não
    // string) -- excluindo "auditoria" daqui, e sem nenhuma outra regra
    // permitindo update/delete nela, esses dois verbos passam a ser
    // negados pra todo mundo, admin incluso; "create" continua liberado
    // pela regra própria de auditoria/{id}.
    match /{document=**} {
      allow write: if souAdmin() && document[0] != "auditoria";
    }
  }
}
