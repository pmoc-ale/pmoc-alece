rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuPerfil().permissao == "admin" &&
        meuPerfil().bloqueado != true;
    }

    function souTrabalhador() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuPerfil().permissao == "trabalhador" &&
        meuPerfil().bloqueado != true;
    }

    function estouBloqueado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        meuPerfil().bloqueado == true;
    }

    match /usuarios/{uid} {
      // Sempre pode ler o próprio documento (necessário pra tela de login
      // detectar "conta bloqueada" antes de negar acesso). Ler o cadastro
      // de OUTRO usuário só pra admin -- antes bastava estar logado e não
      // bloqueado, o que deixava qualquer colega ler o perfil completo de
      // qualquer outro, inclusive perguntaSeguranca/respostaSegurancaHash
      // (pergunta de recuperação de senha, de baixa entropia -- nome da
      // mãe, cidade natal etc.). A checagem de "nome de usuário já existe"
      // (usuarioJaExiste em app.js) não precisa mais disso -- usa a lista
      // separada e sem dado sensível em configuracoes/usuariosEmUso logo
      // abaixo.
      allow read: if request.auth != null && (request.auth.uid == uid || souAdmin());

      // Auto-cadastro (tela de login pública): só cria como "padrão" e não
      // bloqueado, não importa o que a pessoa tente mandar no resto do
      // documento. Quando é o ADMIN criando a conta de outra pessoa (tela
      // de Usuários, onde ele escolhe a permissão), não trava nada -- ele
      // já é uma conta de confiança e precisa poder escolher trabalhador/admin.
      allow create: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.permissao == "padrao"
          && request.resource.data.bloqueado == false)
        || souAdmin()
      );

      // Editar o próprio perfil não pode mudar a própria permissão nem se
      // desbloquear sozinho -- só um admin (de verdade, não bloqueado) pode
      // mudar esses dois campos, seja no próprio perfil ou no de outra pessoa.
      allow update: if request.auth != null && (
        souAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.permissao == resource.data.permissao
          && request.resource.data.bloqueado == resource.data.bloqueado)
      );
    }

    match /ciclos/{cicloId}/equipamentos/{itemId} {
      allow create, update: if souTrabalhador();
    }
    match /ciclos/{cicloId}/backupPlanilha/{docId} {
      // Guarda o "antes" de uma atualização de cadastro via planilha, pra
      // dar pra desfazer -- mesmo nível de permissão de quem pode fazer a
      // própria atualização (senão a atualização quebra pra quem não é
      // admin, porque salvar o backup é parte da mesma operação).
      allow read, create, update, delete: if souTrabalhador();
    }
    match /ciclos/{cicloId}/historico/{id} {
      // Só cria -- editar/apagar um registro já existente fica só com admin
      // (é um log de manutenção, não devia dar pra reescrever depois).
      allow create: if souTrabalhador();
    }
    match /ciclos/{cicloId}/ordens/{id} {
      allow create, update, delete: if souTrabalhador();
    }
    match /infoCondensadoras/{equipamentoId} {
      allow create, update: if souTrabalhador();
    }

    // Inscrição de notificação push do navegador (ver ativarNotificacoesPush
    // em app.js) -- um documento por pessoa (id = o próprio uid), só ela
    // pode criar/atualizar/apagar a própria. A leitura já cai na regra
    // genérica lá embaixo (qualquer autenticado não bloqueado) -- é assim
    // que o Worker de avisos (que loga como um usuário "trabalhador" comum,
    // não como admin) consegue ler todas as inscrições pra mandar os avisos.
    match /pushSubscriptions/{uid} {
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lista de nomes de usuário já em uso (só o nome -- nenhum dado
    // sensível) -- existe pra "Minha conta" avisar "esse usuário já
    // existe" sem precisar ler o perfil completo de ninguém (ver
    // usuarios/{uid} acima, que agora só deixa ler o próprio ou admin).
    // hasOnly(["nomes"]) trava a escrita só nesse campo, pra um usuário
    // mal-intencionado não poder usar esse documento pra gravar outra
    // coisa qualquer.
    match /configuracoes/usuariosEmUso {
      allow read: if request.auth != null && !estouBloqueado();
      allow write: if request.auth != null && !estouBloqueado()
        && request.resource.data.keys().hasOnly(["nomes"]);
    }

    // A regra genérica lá embaixo só deixa ADMIN escrever -- sem essa regra
    // própria, qualquer pessoa não-admin mudando o próprio nome/usuário/
    // senha em "Minha conta" teria o registro de auditoria negado (a ação
    // em si funciona, só o LOG dela que sumiria, sem erro visível pra
    // ninguém perceber). Só cria (nunca edita/apaga um log já existente);
    // ver quem mudou o quê continua só pra admin.
    match /auditoria/{id} {
      allow read: if souAdmin();
      allow create: if request.auth != null && !estouBloqueado();
    }

    match /{document=**} {
      allow read: if request.auth != null && !estouBloqueado();
      allow write: if souAdmin();
    }
  }
}
